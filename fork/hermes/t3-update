#!/bin/bash
# Installs "T3 Code (Brandon)" builds published by fork/sync.sh on Zeus.
#
#   t3-update            Download the latest build if needed, then quit the
#                        app, swap it in and reopen it.
#   t3-update check      Download a new build into staging (runs from
#                        launchd). Installs straight away if the app is not
#                        running.
#   t3-update watch      Runs under launchd: installs a staged build as soon as
#                        the app quits, and when the app starts, checks Zeus
#                        and restarts it into a newer build if one is ready
#                        within LAUNCH_UPDATE_WINDOW seconds.
#   t3-update rollback   Restore the previously installed build.
#   t3-update status     Show installed, staged and latest builds.

set -euo pipefail

ZEUS="${T3FORK_ZEUS:-brandongomes@zeus.tail91d1cf.ts.net}"
REMOTE_BUILDS="${T3FORK_REMOTE_BUILDS:-t3-fork-builds}"
APP_NAME="T3 Code (Brandon)"
APP="/Applications/$APP_NAME.app"
STATE="$HOME/Library/Application Support/t3-fork"
STAGED="$STATE/staged"
PREVIOUS="$STATE/previous"
# Only restart the app for an update this soon after it opens, so a slow
# download never interrupts work already under way.
LAUNCH_UPDATE_WINDOW=30

mkdir -p "$STATE"
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

log() { echo "[t3-update] $*"; }

notify() { # title message
  osascript -e "display notification \"${2//\"/\\\"}\" with title \"${1//\"/\\\"}\"" >/dev/null 2>&1 || true
}

remote() { ssh -n -o BatchMode=yes -o ConnectTimeout=10 "$ZEUS" "$@"; }

json_field() { # file field
  /usr/bin/plutil -extract "$2" raw -o - "$1" 2>/dev/null || true
}

installed_id() { cat "$STATE/installed-build" 2>/dev/null || true; }
staged_id() { cat "$STAGED/build" 2>/dev/null || true; }

# pgrep truncates names to 16 characters and treats the parentheses as regex,
# so match the executable path literally. No grep -q: it exits on the first
# match, ps gets SIGPIPE, and pipefail then reports "not running".
app_running() { ps -axo comm= | grep -F "/$APP_NAME.app/Contents/MacOS/" >/dev/null; }

# Per-process temp names: the 30-minute check and the watcher can fetch at once.
fetch_latest() {
  remote "cat $REMOTE_BUILDS/latest.json" >"$STATE/latest.json.$$.tmp" || {
    rm -f "$STATE/latest.json.$$.tmp"
    return 1
  }
  mv "$STATE/latest.json.$$.tmp" "$STATE/latest.json"
  if remote "cat $REMOTE_BUILDS/status.json" >"$STATE/status.json.$$.tmp" 2>/dev/null; then
    mv "$STATE/status.json.$$.tmp" "$STATE/status.json"
  else
    rm -f "$STATE/status.json.$$.tmp"
  fi
}

report_failure() {
  [[ -f "$STATE/status.json" ]] || return 0
  [[ "$(json_field "$STATE/status.json" state)" == "failed" ]] || return 0
  local at
  at="$(json_field "$STATE/status.json" at)"
  [[ "$at" != "$(cat "$STATE/notified-failure" 2>/dev/null || true)" ]] || return 0
  echo "$at" >"$STATE/notified-failure"
  notify "T3 Code (Brandon) build failed" "$(json_field "$STATE/status.json" message)"
}

stage_latest() { with_lock stage_latest_locked; }

stage_latest_locked() {
  local id zip sha tmp
  id="$(json_field "$STATE/latest.json" buildId)"
  [[ -n "$id" ]] || { log "No build published yet"; return 1; }
  if [[ "$id" == "$(installed_id)" || "$id" == "$(staged_id)" ]]; then
    return 0
  fi
  zip="$(json_field "$STATE/latest.json" zip)"
  sha="$(json_field "$STATE/latest.json" sha256)"
  log "Downloading $id"
  tmp="$(mktemp -d "$STATE/download.XXXXXX")"
  scp -q -o BatchMode=yes "$ZEUS:$zip" "$tmp/build.zip" || { rm -rf "$tmp"; log "Download failed for $id"; return 1; }
  [[ "$(shasum -a 256 "$tmp/build.zip" | cut -d' ' -f1)" == "$sha" ]] || {
    rm -rf "$tmp"
    log "Checksum mismatch for $id"
    return 1
  }
  ditto -x -k "$tmp/build.zip" "$tmp/app" || { rm -rf "$tmp"; log "Could not unpack $id"; return 1; }
  [[ -d "$tmp/app/$APP_NAME.app" ]] || { rm -rf "$tmp"; log "Zip has no $APP_NAME.app"; return 1; }
  rm -f "$tmp/build.zip"
  echo "$id" >"$tmp/build"
  rm -rf "$STAGED"
  mv "$tmp" "$STAGED"
  log "Staged $id"
}

# The watcher, the 30-minute check and the sidebar button can all stage or
# install at once. Without this lock, a second install moved the freshly
# installed app aside and then found nothing staged, leaving no app at all.
with_lock() { # command...
  local lock="$STATE/update.lock" pid rc=0
  for _ in $(seq 1 300); do
    if mkdir "$lock" 2>/dev/null; then
      echo $$ >"$lock/pid"
      "$@" || rc=$?
      rm -rf "$lock"
      return $rc
    fi
    pid="$(cat "$lock/pid" 2>/dev/null || true)"
    if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
      rm -rf "$lock"
      continue
    fi
    sleep 1
  done
  log "Another update is still running"
  return 1
}

install_staged() { with_lock install_staged_locked "$@"; }

install_staged_locked() {
  local id
  id="$(staged_id)"
  [[ -n "$id" ]] || { log "Nothing staged"; return 0; }
  [[ -d "$STAGED/app/$APP_NAME.app" ]] || {
    log "Staged $id has no app; discarding it"
    rm -rf "$STAGED"
    return 1
  }
  local was_running=0
  if app_running; then
    was_running=1
    log "Quitting $APP_NAME"
    osascript -e "tell application \"$APP_NAME\" to quit" >/dev/null 2>&1 || true
    for _ in $(seq 1 30); do app_running || break; sleep 1; done
    app_running && { log "$APP_NAME did not quit; try again"; return 1; }
  fi
  rm -rf "$PREVIOUS"
  if [[ -d "$APP" ]]; then
    mkdir -p "$PREVIOUS"
    mv "$APP" "$PREVIOUS/" || { log "Could not move the current app aside"; return 1; }
    installed_id >"$PREVIOUS/build"
  fi
  if ! mv "$STAGED/app/$APP_NAME.app" "$APP"; then
    log "Could not install $id; restoring the previous build"
    [[ -d "$PREVIOUS/$APP_NAME.app" && ! -e "$APP" ]] && mv "$PREVIOUS/$APP_NAME.app" "$APP"
    return 1
  fi
  xattr -dr com.apple.quarantine "$APP" 2>/dev/null || true
  echo "$id" >"$STATE/installed-build"
  rm -rf "$STAGED"
  log "Installed $id"
  [[ $1 == "reopen" || $was_running -eq 1 ]] && open "$APP"
  return 0
}

case "${1:-install}" in
  check)
    fetch_latest || { log "Could not reach Zeus"; exit 0; }
    report_failure
    stage_latest || exit 0
    [[ -n "$(staged_id)" ]] || exit 0
    # A running app picks the staged build up when it next quits or starts.
    app_running || install_staged noreopen
    ;;
  install)
    fetch_latest || log "Could not reach Zeus; using any staged build"
    stage_latest || true
    if [[ -z "$(staged_id)" ]]; then
      log "Already on $(installed_id)"
      exit 0
    fi
    install_staged reopen
    ;;
  watch)
    # Start from the current state so an already-open app isn't treated as
    # just launched (and restarted) when the watcher itself starts.
    if app_running; then was_running=1; else was_running=0; fi
    while true; do
      if app_running; then running=1; else running=0; fi
      if [[ $running -eq 0 && -n "$(staged_id)" ]]; then
        install_staged noreopen || true
      fi
      if [[ $running -eq 1 && $was_running -eq 0 ]]; then
        launched_at=$(date +%s)
        if [[ -z "$(staged_id)" ]]; then
          { fetch_latest && stage_latest; } || true
        fi
        if [[ -n "$(staged_id)" ]] && (($(date +%s) - launched_at < LAUNCH_UPDATE_WINDOW)); then
          notify "Updating T3 Code (Brandon)" "Restarting into $(staged_id)"
          install_staged reopen || true
        fi
      fi
      was_running=$running
      sleep 2
    done
    ;;
  rollback)
    [[ -d "$PREVIOUS/$APP_NAME.app" ]] || { log "No previous build"; exit 1; }
    app_running && osascript -e "tell application \"$APP_NAME\" to quit" >/dev/null 2>&1 || true
    for _ in $(seq 1 30); do app_running || break; sleep 1; done
    rm -rf "$APP"
    mv "$PREVIOUS/$APP_NAME.app" "$APP"
    cp "$PREVIOUS/build" "$STATE/installed-build"
    rm -rf "$PREVIOUS"
    log "Rolled back to $(installed_id)"
    open "$APP"
    ;;
  status)
    echo "installed: $(installed_id)"
    echo "staged:    $(staged_id)"
    fetch_latest 2>/dev/null && {
      echo "latest:    $(json_field "$STATE/latest.json" buildId)"
      echo "zeus sync: $(json_field "$STATE/status.json" state) - $(json_field "$STATE/status.json" message) ($(json_field "$STATE/status.json" at))"
      echo "changes:"
      json_field "$STATE/latest.json" changes
    }
    ;;
  *)
    sed -n '2,12p' "$0"
    exit 2
    ;;
esac
